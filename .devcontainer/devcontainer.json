{
  "name": "Legal Bro — п.23 (Copilot)",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "files.encoding": "utf8",
        "files.eol": "\n"
      }
    }
  },
  "postCreateCommand": "git config --global core.autocrlf false && git config --global core.quotepath false",
  "remoteEnv": {
    "PYTHONIOENCODING": "utf-8"
  }
}
